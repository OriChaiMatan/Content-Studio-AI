# Dependencies & build outputs (rebuilt inside the image)
node_modules
**/node_modules
dist
backend/dist

# Secrets / local env — never copy into the build context
.env
.env.*
backend/.env
backend/.env.*
!**/.env.example
!**/.env.production.example

# VCS, logs, OS cruft, IDE
.git
.gitignore
*.log
.DS_Store
.vscode
.idea

# Docs / misc not needed at runtime
*.md
