generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(cuid())
  name                    String
  email                   String                  @unique
  role                    String                  @default("Editor")
  avatarUrl               String?
  language                Language                @default(en)
  notifGenerationComplete Boolean                 @default(true)
  notifFactCheckConflict  Boolean                 @default(true)
  notifDraftReady         Boolean                 @default(false)
  lastActiveAt            DateTime                @default(now())
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  passwordHash            String?
  cases                   ContentCase[]
  passwordResetTokens     PasswordResetToken[]
  telegramIdentity        TelegramIdentity?
  whatsappIdentity        WhatsAppIdentity?
  whatsappPendingSource   WhatsAppPendingSource[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ContentCase {
  id                   String            @id @default(cuid())
  userId               String
  title                String
  status               CaseStatus        @default(draft)
  language             Language          @default(en)
  targetAudience       String            @default("")
  industry             String            @default("")
  experienceLevel      ExperienceLevel   @default(intermediate)
  writingStyle         String            @default("")
  goals                String            @default("")
  aiInstructions       String            @default("")
  scheduleFrequency    ScheduleFrequency @default(manual)
  scheduleTime         String?
  scheduleDayOfWeek    Int?
  scheduleDayOfMonth   Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  contentGoal          ContentGoal       @default(build_authority)
  contentStyle         ContentStyle      @default(professional)
  contentTargets       String[]          @default([])
  goalCustom           String?
  styleCustom          String?
  lastScheduledSlotKey String?
  user                 User              @relation(fields: [userId], references: [id])
  outputs              ContentOutput[]
  sources              ContentSource[]
  libraryItems         LibraryItem[]
  pipelineRuns         PipelineRun[]
  pipelineSteps        PipelineStep[]
  podcastEpisodes      PodcastEpisode[]

  @@index([userId, status])
  @@index([updatedAt(sort: Desc)])
  @@map("content_cases")
}

model ContentSource {
  id                 String       @id @default(cuid())
  contentCaseId      String
  type               SourceType
  label              String
  content            String
  filePath           String?
  fileSize           Int?
  mimeType           String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime?
  lastUsedAt         DateTime?
  status             SourceStatus @default(new)
  usedInRunId        String?
  sourceIntelligence Json?
  extractedAt        DateTime?
  extractedText      String?
  extractedTitle     String?
  extractionError    String?
  extractionStatus   String?
  contentCase        ContentCase  @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)

  @@index([contentCaseId, createdAt(sort: Desc)])
  @@index([contentCaseId, status])
  @@map("content_sources")
}

model ContentOutput {
  id                 String        @id @default(cuid())
  contentCaseId      String
  pipelineRunId      String?
  platform           Platform
  title              String
  body               String
  status             OutputStatus  @default(draft)
  version            String        @default("v1.0.0")
  contentScore       Int?
  researchConfidence Int?
  factCheckAccuracy  Int?
  generatedAt        DateTime      @default(now())
  reviewedAt         DateTime?
  breakdown          Json?
  metadata           Json?
  contentCase        ContentCase   @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)
  pipelineRun        PipelineRun?  @relation(fields: [pipelineRunId], references: [id])
  libraryItem        LibraryItem?
  visualAssets       VisualAsset[]

  @@index([contentCaseId, platform])
  @@index([contentCaseId, status])
  @@map("content_outputs")
}

model VisualAsset {
  id               String        @id @default(cuid())
  contentOutputId  String
  contentCaseId    String
  version          Int           @default(1)
  platform         Platform
  language         Language      @default(en)
  status           VisualStatus  @default(pending)
  visualCategory   String?
  visualIntent     String?
  backgroundPrompt String?
  overlaySpec      Json?
  provider         String?
  model            String?
  backgroundKey    String?
  finalKey         String?
  width            Int?
  height           Int?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  contentOutput    ContentOutput @relation(fields: [contentOutputId], references: [id], onDelete: Cascade)

  @@index([contentOutputId, version(sort: Desc)])
  @@map("visual_assets")
}

model PipelineStep {
  id            String             @id @default(cuid())
  contentCaseId String
  name          PipelineStepName
  status        PipelineStepStatus @default(idle)
  startedAt     DateTime?
  completedAt   DateTime?
  summary       String?
  confidence    Int?
  contentCase   ContentCase        @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)

  @@unique([contentCaseId, name])
  @@map("pipeline_steps")
}

model PipelineRun {
  id               String          @id @default(cuid())
  contentCaseId    String
  triggeredBy      String          @default("manual")
  status           JobStatus       @default(running)
  sourceCount      Int             @default(0)
  startedAt        DateTime        @default(now())
  completedAt      DateTime?
  errorMessage     String?
  contextSourceIds String[]        @default([])
  primarySourceIds String[]        @default([])
  contentPackage   Json?
  factCheckReport  Json?
  researchContext  Json?
  outputLanguage   String?
  outputs          ContentOutput[]
  libraryItems     LibraryItem[]
  jobs             PipelineJob[]
  podcastEpisodes  PodcastEpisode[]
  contentCase      ContentCase     @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)

  @@index([contentCaseId, startedAt(sort: Desc)])
  @@map("pipeline_runs")
}

model PipelineJob {
  id            String           @id @default(cuid())
  pipelineRunId String
  stepName      PipelineStepName
  status        JobStatus        @default(pending)
  queueJobId    String?
  attempts      Int              @default(0)
  maxAttempts   Int              @default(3)
  startedAt     DateTime?
  completedAt   DateTime?
  result        Json?
  errorMessage  String?
  createdAt     DateTime         @default(now())
  pipelineRun   PipelineRun      @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId, stepName])
  @@map("pipeline_jobs")
}

model LibraryItem {
  id            String        @id @default(cuid())
  contentCaseId String
  outputId      String        @unique
  platform      Platform
  title         String
  body          String
  status        OutputStatus
  version       String
  date          DateTime      @default(now())
  pipelineRunId String?
  contentCase   ContentCase   @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)
  output        ContentOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  pipelineRun   PipelineRun?  @relation(fields: [pipelineRunId], references: [id])

  @@index([contentCaseId])
  @@index([pipelineRunId])
  @@index([platform, status])
  @@map("library_items")
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  waMessageId String?  @unique
  phoneE164   String
  direction   String
  kind        String
  body        String
  raw         Json?
  createdAt   DateTime @default(now())

  @@index([phoneE164, createdAt])
  @@map("whatsapp_messages")
}

model WhatsAppIdentity {
  id            String    @id @default(cuid())
  userId        String    @unique
  phoneE164     String    @unique
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  verifyCode    String?
  verifyExpires DateTime?
  attemptCount  Int       @default(0)
  optOut        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneE164])
  @@map("whatsapp_identities")
}

model WhatsAppPendingSource {
  id          String   @id @default(cuid())
  userId      String
  sourceType  String
  label       String
  content     String
  caseOptions Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  caseId      String?
  mode        String   @default("select_case")
  sourceId    String?
  channel     String   @default("whatsapp")
  externalId  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([userId])
  @@map("whatsapp_pending_sources")
}

model TelegramIdentity {
  id             String    @id @default(cuid())
  userId         String    @unique
  telegramUserId String?   @unique
  chatId         String?
  username       String?
  displayName    String?
  verified       Boolean   @default(false)
  verifyToken    String?
  verifyExpires  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_identities")
}

model ChannelInboundDedup {
  id         String   @id @default(cuid())
  channel    String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([channel, externalId])
  @@map("channel_inbound_dedup")
}

enum Language {
  en
  he
}

enum SourceType {
  text
  url
  pdf
}

enum ContentGoal {
  build_authority
  generate_leads
  increase_sales
  educate_audience
  grow_community
  personal_branding
  other
}

enum ContentStyle {
  professional
  authoritative
  friendly
  personal
  journalistic
  provocative
  humorous
  other
}

enum SourceStatus {
  new
  used
  ignored
  error
}

enum Platform {
  linkedin
  facebook
  instagram
  newsletter
  podcast
  image_prompt
}

enum CaseStatus {
  draft
  research
  fact_check
  generating
  in_review
  completed
}

enum OutputStatus {
  draft
  approved
  rejected
}

enum VisualStatus {
  pending
  generating
  rendering
  ready
  failed
}

enum ScheduleFrequency {
  manual
  daily
  weekly
  monthly
}

enum ExperienceLevel {
  beginner
  intermediate
  expert
}

enum PipelineStepName {
  research
  fact_check
  content_creation
}

enum PipelineStepStatus {
  idle
  running
  completed
  error
}

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}

// ── Podcast Engine ────────────────────────────────────────────────────────────

enum PodcastEpisodeStatus {
  pending          // row created, runner not yet started
  generating       // runner active (Stage 1 in progress)
  pack_ready       // Stage 1 complete: researchPack stored
  blueprint_ready  // Stage 2 complete: blueprint stored; Stage 3 starts immediately
  critique_ready   // Stage 4 complete: critique stored
  completed        // Stage 5 complete: full episode ready
  failed           // terminal error; see errorMessage
}

model PodcastEpisode {
  id                   String               @id @default(cuid())
  contentCaseId        String
  pipelineRunId        String
  version              Int                  @default(1)

  status               PodcastEpisodeStatus @default(pending)
  errorMessage         String?

  // Stage 1 artifact
  researchPack         Json?
  // Stage 2 artifact
  blueprint            Json?
  // Stage 3 artifacts — sections array grows as each section completes
  sections             Json?
  sectionsCompleted    Int                  @default(0)
  // Stage 4 artifact
  critique             Json?
  // Stage 5 artifact
  podcastPackage       Json?

  // Denormalized summary fields — set at completion (Stage 5)
  title                String               @default("")
  subtitle             String               @default("")
  language             String               @default("en")
  wordCount            Int                  @default(0)
  estimatedDurationMin Int                  @default(0)
  researchDensity      String               @default("limited")
  qualityStatus        String?              // pass | needs_review | blocked
  approximateCostUsd   Float?

  // Per-stage timing — set at completion
  telemetry            Json?

  startedAt            DateTime             @default(now())
  completedAt          DateTime?
  updatedAt            DateTime             @updatedAt

  contentCase          ContentCase          @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)
  pipelineRun          PipelineRun          @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([contentCaseId, startedAt(sort: Desc)])
  @@index([pipelineRunId, startedAt(sort: Desc)])
  @@index([pipelineRunId, version(sort: Desc)])
  @@map("podcast_episodes")
}
