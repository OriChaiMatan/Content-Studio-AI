// ─────────────────────────────────────────────────────────────────────────────
// Content Studio AI — Prisma Schema
// PostgreSQL + Prisma ORM
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Language {
  en
  he
}

enum SourceType {
  text
  url
  pdf
}

// What the user wants to achieve with this Content Case
enum ContentGoal {
  build_authority
  generate_leads
  increase_sales
  educate_audience
  grow_community
  personal_branding
  other
}

// Tone/voice for content generation
enum ContentStyle {
  professional
  authoritative
  friendly
  personal
  journalistic
  provocative
  humorous
  other
}

// Lifecycle of a ContentSource within its Case.
// new     → just added, available as primary material for the next pipeline run
// used    → consumed as primary source in a completed run that was approved (Phase 5)
// ignored → manually excluded by the user from future runs
// error   → could not be processed (URL unreachable, PDF parse failure, etc.)
enum SourceStatus {
  new
  used
  ignored
  error
}

enum Platform {
  linkedin
  facebook
  instagram
  newsletter
  podcast
  image_prompt
}

enum CaseStatus {
  draft
  research
  fact_check
  generating
  in_review
  completed
}

enum OutputStatus {
  draft
  approved
  rejected
}

enum ScheduleFrequency {
  manual
  daily
  weekly
  monthly
}

enum ExperienceLevel {
  beginner
  intermediate
  expert
}

enum PipelineStepName {
  research
  fact_check
  content_creation
}

enum PipelineStepStatus {
  idle
  running
  completed
  error
}

enum JobStatus {
  pending
  running
  completed
  failed
  cancelled
}

// ── Models ────────────────────────────────────────────────────────────────────

// Users — userId FK is present on ContentCase now so auth can be added
// without a schema migration later.
model User {
  id                      String        @id @default(cuid())
  name                    String
  email                   String        @unique
  // Phase 12 — auth credential. Nullable so the migration is non-destructive to the
  // existing seed user and leaves room for future passwordless/OAuth users. Email+
  // password registration always sets it. NEVER serialized to the client.
  passwordHash            String?
  role                    String        @default("Editor")
  avatarUrl               String?
  language                Language      @default(en)
  // Notification preferences (denormalized — no separate prefs table needed)
  notifGenerationComplete Boolean       @default(true)
  notifFactCheckConflict  Boolean       @default(true)
  notifDraftReady         Boolean       @default(false)
  lastActiveAt            DateTime      @default(now())
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  cases                   ContentCase[]
  // Phase 13B — optional 1:1 WhatsApp channel identity. Nullable so legacy/seed
  // users (and any future passwordless flows) remain valid without a number.
  whatsappIdentity        WhatsAppIdentity?
  // Phase 13D — short-lived pending sources awaiting a case selection / manual text.
  // Now one-to-many: a user may hold one pending per channel (whatsapp/telegram).
  whatsappPendingSource   WhatsAppPendingSource[]

  @@map("users")
}

// ContentCase — the core persistent workspace.
// Sources are added over time; generation uses all sources present at run time.
model ContentCase {
  id                 String            @id @default(cuid())
  userId             String
  title              String
  status             CaseStatus        @default(draft)
  language           Language          @default(en)
  targetAudience     String            @default("")
  industry           String            @default("")
  experienceLevel    ExperienceLevel   @default(intermediate)
  writingStyle       String            @default("") @db.Text
  goals              String            @default("") @db.Text
  aiInstructions     String            @default("") @db.Text

  // Schedule columns — denormalized from the Schedule interface.
  // Serialized back to { frequency, time, dayOfWeek, dayOfMonth } by the API layer.
  scheduleFrequency  ScheduleFrequency @default(manual)
  scheduleTime       String?           // "HH:MM" — null for manual
  scheduleDayOfWeek  Int?              // 0–6 for weekly; null otherwise
  scheduleDayOfMonth Int?              // 1–31 for monthly; null otherwise

  // Phase 14C — scheduler idempotency. The unique key of the scheduled slot the
  // scheduler last processed for this case, e.g. "2026-06-16|daily|14:30". Set once
  // per due slot (consume-on-due) so a slot fires at most once even across overlapping
  // ticks. Null until the scheduler first processes a slot for this case.
  lastScheduledSlotKey String?

  // ── Simplified wizard fields ────────────────────────────────────────────────
  // Collected in the 3-step wizard. Old cases default to first option / empty.
  contentGoal    ContentGoal  @default(build_authority)
  goalCustom     String?                   // free text when goal = 'other'
  contentStyle   ContentStyle @default(professional)
  styleCustom    String?                   // free text when style = 'other'
  // Which platforms the pipeline generates outputs for.
  // Empty [] = legacy backward compat (generate all 6). New cases must be non-empty.
  contentTargets String[]     @default([])

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id])
  sources            ContentSource[]
  outputs            ContentOutput[]
  pipelineSteps      PipelineStep[]    // current step state (always 3 rows per case)
  pipelineRuns       PipelineRun[]     // full execution history
  libraryItems       LibraryItem[]

  @@index([userId, status])
  @@index([updatedAt(sort: Desc)])
  @@map("content_cases")
}

// ContentSource — added continuously over the case lifetime.
// Supports text notes, URLs, and PDF file references.
// Each source has a lifecycle: new → used (on approval in Phase 5).
model ContentSource {
  id            String        @id @default(cuid())
  contentCaseId String
  type          SourceType
  label         String
  content       String        @db.Text  // text body, URL string, or original filename
  filePath      String?                 // server-side path for PDF files
  fileSize      Int?                    // bytes; null for text and url types
  mimeType      String?                 // "application/pdf" or null

  // Source lifecycle — managed by the pipeline and approval systems.
  status        SourceStatus  @default(new)
  usedInRunId   String?                 // ID of the run that last consumed this source (set in Phase 5)
  lastUsedAt    DateTime?               // timestamp of last use (set in Phase 5)

  // Deterministic mock analysis generated on create/edit. Null for legacy sources.
  sourceIntelligence Json?

  // URL content extraction (Phase 8.5). Populated for url sources only.
  // extractionStatus values: "pending" | "success" | "partial" | "failed" | "skipped".
  // "partial" = OG/meta preview text only (Phase B) — full body unavailable.
  // content always remains the original URL; extracted body lives here.
  extractedTitle    String?
  extractedText     String?  @db.Text
  extractionStatus  String?
  extractionError   String?
  extractedAt       DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime?               // null until a text source is edited

  contentCase   ContentCase   @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)

  @@index([contentCaseId, createdAt(sort: Desc)])
  @@index([contentCaseId, status])
  @@map("content_sources")
}

// ContentOutput — one row per platform per pipeline run.
// Tracks editorial status and quality scores from AI generation.
model ContentOutput {
  id                 String       @id @default(cuid())
  contentCaseId      String
  pipelineRunId      String?      // links output to the run that produced it
  platform           Platform
  title              String
  body               String       @db.Text
  status             OutputStatus @default(draft)
  version            String       @default("v1.0.0")
  contentScore       Int?         // 0–100 AI quality score; null until AI is connected
  researchConfidence Int?         // 0–100
  factCheckAccuracy  Int?         // 0–100
  // Content Output v2 (Phase 9). body = readyToPublish (editable). breakdown is
  // the read-only platform-specific structure; metadata holds hashtags, image
  // prompts, reading time / duration, generatorVersion, degraded flag, etc.
  // Null on legacy v1 outputs → consumers fall back to body.
  breakdown          Json?
  metadata           Json?
  generatedAt        DateTime     @default(now())
  reviewedAt         DateTime?    // set when status is changed to approved/rejected

  contentCase        ContentCase  @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)
  pipelineRun        PipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  libraryItem        LibraryItem?

  @@index([contentCaseId, platform])
  @@index([contentCaseId, status])
  @@map("content_outputs")
}

// PipelineStep — current state of each of the 3 steps for a case.
// Always exactly 3 rows per ContentCase (enforced by @@unique).
// Reset to idle at the start of each new run; updated as jobs complete.
model PipelineStep {
  id            String             @id @default(cuid())
  contentCaseId String
  name          PipelineStepName
  status        PipelineStepStatus @default(idle)
  startedAt     DateTime?
  completedAt   DateTime?
  summary       String?            @db.Text
  confidence    Int?               // 0–100

  contentCase   ContentCase        @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)

  @@unique([contentCaseId, name])
  @@map("pipeline_steps")
}

// PipelineRun — one record per execution (manual or scheduled).
// Stores which sources were selected as primary (new) vs context (used/background).
model PipelineRun {
  id               String        @id @default(cuid())
  contentCaseId    String
  triggeredBy      String        @default("manual")   // "manual" | "schedule"
  // Output language chosen at generation time (Phase 8.6). "en" | "he".
  // Null on legacy runs → falls back to case.language ?? "en".
  outputLanguage   String?
  status           JobStatus     @default(running)
  // Source selection snapshot at run time
  primarySourceIds String[]      @default([])          // source IDs with status=new, used as main material
  contextSourceIds String[]      @default([])          // source IDs with status=used, used as background only
  sourceCount      Int           @default(0)           // total sources in this run (primary + context)
  startedAt        DateTime      @default(now())
  completedAt      DateTime?
  errorMessage     String?       @db.Text

  // ── AI Pipeline Contract artifacts ───────────────────────────────────────────
  // Populated stage-by-stage as the pipeline advances.
  // Null until that stage completes. Replaced by real AI responses in Phase 8.
  researchContext  Json?         // ResearchContext — Stage 1 output
  factCheckReport  Json?         // FactCheckReport — Stage 2 output
  contentPackage   Json?         // ContentPackage  — Stage 3 output (all 6 platforms + 2 image prompts)

  contentCase      ContentCase   @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)
  outputs          ContentOutput[]
  jobs             PipelineJob[]
  libraryItems     LibraryItem[]

  @@index([contentCaseId, startedAt(sort: Desc)])
  @@map("pipeline_runs")
}

// PipelineJob — one row per BullMQ job within a PipelineRun.
// Stores the queue job ID for progress lookups, retry tracking, and result metadata.
model PipelineJob {
  id            String           @id @default(cuid())
  pipelineRunId String
  stepName      PipelineStepName
  status        JobStatus        @default(pending)
  queueJobId    String?          // BullMQ job ID — set once job is enqueued
  attempts      Int              @default(0)
  maxAttempts   Int              @default(3)
  startedAt     DateTime?
  completedAt   DateTime?
  result        Json?            // step metadata: source counts, AI model used, token counts, etc.
  errorMessage  String?          @db.Text
  createdAt     DateTime         @default(now())

  pipelineRun   PipelineRun      @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId, stepName])
  @@map("pipeline_jobs")
}

// LibraryItem — approved outputs surfaced in the global Library.
// Created when a ContentOutput is approved; removed on rejection.
// pipelineRunId links the item to its originating run for run-grouped display.
// Multiple runs for the same case each produce their own set of LibraryItems.
model LibraryItem {
  id            String        @id @default(cuid())
  contentCaseId String
  outputId      String        @unique
  pipelineRunId String?                    // which run produced this item (null for legacy items)
  platform      Platform
  title         String
  body          String        @db.Text
  status        OutputStatus
  version       String
  date          DateTime      @default(now())

  contentCase   ContentCase   @relation(fields: [contentCaseId], references: [id], onDelete: Cascade)
  output        ContentOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  pipelineRun   PipelineRun?  @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)

  @@index([contentCaseId])
  @@index([pipelineRunId])
  @@index([platform, status])
  @@map("library_items")
}

// WhatsAppMessage — Phase 13A inbound/outbound log + idempotency.
// waMessageId is Meta's globally-unique message id; the @unique constraint is the
// dedupe key so retried inbound webhooks never create duplicate rows. Outbound rows
// carry no waMessageId (null). This table is logging/plumbing only — it has no FK to
// User or ContentCase yet (phone→user mapping arrives in a later phase).
model WhatsAppMessage {
  id          String   @id @default(cuid())
  waMessageId String?  @unique           // Meta message id — idempotency key (inbound only)
  phoneE164   String                     // sender (inbound) / recipient (outbound)
  direction   String                     // "inbound" | "outbound"
  kind        String                     // "inbound" | "echo" | "error"
  body        String   @db.Text
  raw         Json?                       // parsed Meta message object (inbound), for debugging
  createdAt   DateTime @default(now())

  @@index([phoneE164, createdAt])
  @@map("whatsapp_messages")
}

// WhatsAppIdentity — Phase 13B. One verified WhatsApp number per user (MVP).
// Created at registration with verified=false; flipped to true by user-initiated
// verification (the user sends verifyCode from their WhatsApp to the business
// number; the inbound webhook matches sender + code). verifyCode/verifyExpires are
// transient secrets and are NEVER serialized to the client. phoneE164 is stored in
// canonical E.164 ("+972501234567"); inbound matching reconciles against Meta's
// digit-only `from` via a shared normalizer.
model WhatsAppIdentity {
  id            String    @id @default(cuid())
  userId        String    @unique           // one number per user (MVP)
  phoneE164     String    @unique           // canonical E.164, e.g. "+972501234567"
  verified      Boolean   @default(false)
  verifiedAt    DateTime?
  verifyCode    String?                     // single-use; cleared on success
  verifyExpires DateTime?                   // now + 60 min on (re)generation
  attemptCount  Int       @default(0)       // wrong-code guard
  optOut        Boolean   @default(false)   // declared now; used by a later notification phase
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneE164])
  @@map("whatsapp_identities")
}

// WhatsAppPendingSource — Phase 13D. A classified inbound message held while a
// verified sender chooses which of their multiple active cases to file it in.
// One pending per phone/user (unique phoneE164) → "new pending replaces previous"
// is a single upsert. caseOptions is a STORED SNAPSHOT of the numbered list shown
// (ordered [{ index, caseId, title }]); selection resolves against it, then the
// chosen case is re-checked live (owned + exists + not completed) before ingest.
// Lazy expiry only (no sweeper): expiresAt is checked on read.
// Channel-agnostic since Phase 1 of multi-channel ingestion: addressing is
// (channel, externalId) rather than phoneE164, so the same pending/recovery flow
// serves WhatsApp and (later) Telegram. Table/model name kept for a minimal,
// non-breaking migration. One pending per (channel, externalId).
model WhatsAppPendingSource {
  id          String   @id @default(cuid())
  userId      String                     // FK; NOT unique — a user may have one pending per channel
  channel     String   @default("whatsapp")  // 'whatsapp' | 'telegram'
  externalId  String                     // phoneE164 (whatsapp) / chat id (telegram); upsert key
  // mode discriminates the pending intent:
  //   'select_case'  → waiting for a numbered case selection (source not yet created)
  //   'manual_text'  → a url source was created with failed/partial extraction; waiting
  //                    for the next plain-text message to attach as manualText.
  mode        String   @default("select_case")
  sourceType  String                     // 'text' | 'url' (String — not SourceType; no pdf)
  label       String
  content     String   @db.Text
  caseOptions Json                        // select_case: ordered [{ index, caseId, title }]; manual_text: []
  // manual_text only — the already-created source to recover.
  caseId      String?
  sourceId    String?
  expiresAt   DateTime                    // now + 30 min
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([userId])
  @@map("whatsapp_pending_sources")
}
