# ─────────────────────────────────────────────────────────────────────────────
# Content Studio AI — PRODUCTION env template (single-origin deployment)
#
# Copy to your host's secret store (Railway/Render variables). DO NOT commit a
# filled-in copy. Only variables the app actually reads are listed here; unused
# .env.example entries (REDIS_URL, S3_*, OPENAI_API_KEY, UPLOAD_DIR, RATE_LIMIT_*)
# are intentionally omitted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
# REQUIRED. Enables secure cookies AND enforces JWT_SECRET (server refuses to
# start without one). The static SPA is only served when this is "production".
NODE_ENV=production
# Most hosts inject PORT automatically; the app falls back to 3001.
PORT=3001

# ── Database ──────────────────────────────────────────────────
# Managed PostgreSQL connection string. Run `prisma migrate deploy` against it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED in production. Long random string (e.g. `openssl rand -hex 32`).
# Rotating it invalidates all sessions (everyone is logged out).
JWT_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# ── Roles / Plans / Usage ──────────────────────────────────────
# Comma-separated allowlist of emails granted the MASTER systemRole (bypasses
# all plan/usage limits; can manage other users' plans). Self-healed on every
# login/lookup — no manual DB changes needed when this list changes.
MASTER_EMAILS=""
# Master switch for plan/usage enforcement. Leave false until Phase 2 has been
# verified against real production usage-counter data (see the approved plan).
ENFORCE_QUOTAS=false

# ── Origin / links ────────────────────────────────────────────
# CORS allow-list. With single-origin (SPA served by this backend) requests are
# same-origin and CORS isn't triggered, but set it to your public URL anyway.
CORS_ORIGIN="https://your-app-domain.com"
# Public base URL of the app — used to build WhatsApp deep links.
APP_BASE_URL="https://your-app-domain.com"

# ── Anthropic / AI ────────────────────────────────────────────
# REQUIRED for real (non-mock) output.
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
# These three default to false → the app runs in MOCK mode. Set true for a real
# pilot (requires ANTHROPIC_API_KEY).
SOURCE_ANALYSIS_ENABLED=true
RESEARCH_SYNTHESIS_ENABLED=true
CONTENT_GENERATION_ENABLED=true
# Optional model / timeout / effort overrides (commented = use the code default shown).
#   Source analysis
# SOURCE_ANALYSIS_MODEL=claude-sonnet-4-6
# SOURCE_ANALYSIS_TIMEOUT_MS=30000
# SOURCE_ANALYSIS_MAX_INPUT_TOKENS=7000
# SOURCE_ANALYSIS_BATCH_CONCURRENCY=5
#   Research synthesis
# RESEARCH_SYNTHESIS_MODEL=claude-sonnet-4-6
# RESEARCH_SYNTHESIS_TIMEOUT_MS=240000
#   Content generation
# CONTENT_GENERATION_MODEL=claude-sonnet-4-6
# CONTENT_GENERATION_TIMEOUT_MS=60000
# CONTENT_GENERATION_PODCAST_TIMEOUT_MS=180000
# CONTENT_GENERATION_CONCURRENCY=3
# CONTENT_GENERATION_EFFORT_SOCIAL=medium
# CONTENT_GENERATION_EFFORT_LONGFORM=high
# CONTENT_NEWSLETTER_MAX_TOKENS=8000
#   Pipeline QA
# PIPELINE_FAIL_ON_DEGRADED=false

# ── Fetching / upload limits (optional — safe defaults shown) ─
# URL_FETCH_TIMEOUT_MS=8000
# URL_FETCH_MAX_CONTENT_BYTES=2097152
# URL_FETCH_MIN_METADATA_CHARS=60
# MAX_FILE_SIZE_BYTES=10485760

# ── Scheduler / reaper (in-process — keep ONE instance) ───────
# Automatic scheduled generation. Leave false unless you want it for the pilot.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15
SCHEDULER_TIMEZONE=Asia/Jerusalem
SCHEDULER_STUCK_RUN_MINUTES=30
# Always-on stuck-run safety net. Default true; leave on.
REAPER_ENABLED=true
REAPER_INTERVAL_MINUTES=10

# ── WhatsApp Cloud API (optional — set when enabling that flow) ───────────────
# The GET verification handshake works even while disabled, so you can register
# the webhook first, then flip WHATSAPP_ENABLED=true + add send credentials.
WHATSAPP_ENABLED=false
WHATSAPP_ECHO_ENABLED=false
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_DISPLAY_NUMBER=""

# ── Telegram Bot API (optional — additional ingestion channel) ───────────────
# Default off (like WhatsApp). When off, the webhook still verifies the secret
# header and dedupes/parses updates, but never sends. The webhook secret MUST be
# set (fail-closed) for the route to accept any update.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=""
# Shared secret passed to setWebhook(secret_token=…); compared to the
# X-Telegram-Bot-Api-Secret-Token header on every update.
TELEGRAM_WEBHOOK_SECRET=""
# Bot API base (override only for a self-hosted/local Bot API server).
TELEGRAM_API_BASE="https://api.telegram.org"
# Bot @username (without @) — builds the t.me/<bot>?start=<token> linking deep link.
TELEGRAM_BOT_USERNAME=""
