# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/content_studio_ai_dev"

# ── CORS ──────────────────────────────────────────────────────
# Vite dev server origin. Comma-separate for multiple origins.
CORS_ORIGIN="http://localhost:5173"

# ── Auth (Phase 12) ───────────────────────────────────────────
# Secret used to sign session JWTs carried in an httpOnly cookie.
# REQUIRED in production; use a long random value. Rotating it logs everyone out.
JWT_SECRET="change-me-to-a-long-random-string"

# ── File Storage ──────────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760

# ── S3 (production only — leave blank in dev) ────────────────
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ── URL Fetcher ───────────────────────────────────────────────
URL_FETCH_TIMEOUT_MS=8000
URL_FETCH_MAX_CONTENT_BYTES=2097152

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PIPELINE_WINDOW_MS=10000
RATE_LIMIT_PIPELINE_MAX=1
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=10

# ── Redis / BullMQ (Phase 4+) ─────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── AI Providers (Phase 9+) ───────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ── Source Analysis Agent (Phase 8B) ──────────────────────────
# Real Claude-powered source analysis. MUST default to false — when off,
# source analysis uses the deterministic mock generator (permanent fallback)
# and never calls Claude. Set to "true" (and supply ANTHROPIC_API_KEY) to
# enable the real agent.
SOURCE_ANALYSIS_ENABLED=false
SOURCE_ANALYSIS_MODEL="claude-sonnet-4-6"
SOURCE_ANALYSIS_MAX_INPUT_TOKENS=7000
SOURCE_ANALYSIS_TIMEOUT_MS=30000
# Phase 11B — max concurrent source-analysis calls in a batch add (rate-limit cap).
SOURCE_ANALYSIS_BATCH_CONCURRENCY=5

# ── Content Generator (Phase 9) ───────────────────────────────
# MUST default false — when off, content generation uses the permanent v2 mock.
CONTENT_GENERATION_ENABLED=false
# Separate flag for long-form podcast generation (falls back to mock if off).
CONTENT_GENERATION_PODCAST_ENABLED=false
CONTENT_GENERATION_MODEL="claude-sonnet-4-6"
CONTENT_GENERATION_EFFORT_SOCIAL=medium
CONTENT_GENERATION_EFFORT_LONGFORM=high
CONTENT_GENERATION_TIMEOUT_MS=60000
CONTENT_GENERATION_PODCAST_TIMEOUT_MS=180000
CONTENT_GENERATION_CONCURRENCY=3
# Phase 11D.2 — newsletter output ceiling (was a hardcoded 4000; raised so complete
# Hebrew newsletters no longer truncate → retry → mock-fallback). Ceiling, not target.
CONTENT_NEWSLETTER_MAX_TOKENS=8000

# ── Research Synthesis (Phase 10A) ────────────────────────────
# Real cross-source synthesis for Research Context. MUST default false — when off,
# the research step uses the permanent v1 mock (wrapped as a v2 stub).
RESEARCH_SYNTHESIS_ENABLED=false
RESEARCH_SYNTHESIS_MODEL="claude-sonnet-4-6"
# Hebrew + many sources can exceed 120s; 240s avoids a degraded mock fallback.
RESEARCH_SYNTHESIS_TIMEOUT_MS=240000

# ── Pipeline integrity (Phase 10D.0) ──────────────────────────
# QA strict mode. Default false (production: continue safely + surface degradation
# everywhere). Set true in validation/CI so a degraded research stage (mock-fallback)
# FAILS the run before content generation — a failed research phase can never
# masquerade as success.
PIPELINE_FAIL_ON_DEGRADED=false

# ── Scheduler (Phase 9+) ──────────────────────────────────────
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15

# ── WhatsApp Cloud API (Phase 13A) ────────────────────────────
# Meta WhatsApp Cloud API webhook plumbing. MUST default false — when off, the
# webhook still verifies signatures and logs inbound messages (testable), but
# NEVER sends an outbound message. The GET verification handshake always works so
# the webhook can be registered with Meta before the feature is switched on.
WHATSAPP_ENABLED=false
# 13A echo helper. Echo may send ONLY when WHATSAPP_ENABLED=true AND this is true
# AND all credentials below are set AND the inbound signature verified.
WHATSAPP_ECHO_ENABLED=false
# GET handshake shared secret (hub.verify_token) chosen when registering the webhook.
WHATSAPP_VERIFY_TOKEN=""
# HMAC key for X-Hub-Signature-256 verification of inbound POSTs (Meta App Secret).
WHATSAPP_APP_SECRET=""
# Outbound send credentials.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Base URL for building deep links into the app (used by later phases; unused in 13A).
APP_BASE_URL="http://localhost:5173"
