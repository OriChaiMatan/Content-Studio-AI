# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/content_studio_ai_dev"

# ── CORS ──────────────────────────────────────────────────────
# Vite dev server origin. Comma-separate for multiple origins.
CORS_ORIGIN="http://localhost:5173"

# ── Rate limiting (Phase Security-1) ──────────────────────────
# Master switch. Defaults ON (production-safe) unless set to exactly "false".
# Auto-skipped under NODE_ENV=test. Set false for noisy local dev.
# Requires `trust proxy = 1` (set in app.ts) so IP limits see the real client IP.
RATE_LIMIT_ENABLED=true
# Optional per-group max overrides (windows are fixed):
#   login   → AUTH_RATE_LIMIT_MAX  / 15 min / IP   (register is fixed at 5 / 60 min / IP)
#   AI-heavy→ AI_RATE_LIMIT_MAX    / 60 min / user (pipeline start|run|advance, regenerate)
#   ingest  → INGEST_RATE_LIMIT_MAX/ 60 min / user (sources, sources/batch)
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=30
INGEST_RATE_LIMIT_MAX=60

# ── Auth (Phase 12) ───────────────────────────────────────────
# Secret used to sign session JWTs carried in an httpOnly cookie.
# REQUIRED in production; use a long random value. Rotating it logs everyone out.
JWT_SECRET="change-me-to-a-long-random-string"

# ── File upload ───────────────────────────────────────────────
MAX_FILE_SIZE_BYTES=10485760

# ── URL Fetcher ───────────────────────────────────────────────
URL_FETCH_TIMEOUT_MS=8000
URL_FETCH_MAX_CONTENT_BYTES=2097152

# ── AI Providers (Phase 9+) ───────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Source Analysis Agent (Phase 8B) ──────────────────────────
# Real Claude-powered source analysis. MUST default to false — when off,
# source analysis uses the deterministic mock generator (permanent fallback)
# and never calls Claude. Set to "true" (and supply ANTHROPIC_API_KEY) to
# enable the real agent.
SOURCE_ANALYSIS_ENABLED=false
SOURCE_ANALYSIS_MODEL="claude-sonnet-4-6"
SOURCE_ANALYSIS_MAX_INPUT_TOKENS=7000
SOURCE_ANALYSIS_TIMEOUT_MS=30000
# Phase 11B — max concurrent source-analysis calls in a batch add (rate-limit cap).
SOURCE_ANALYSIS_BATCH_CONCURRENCY=5

# ── Content Generator (Phase 9) ───────────────────────────────
# MUST default false — when off, content generation uses the permanent v2 mock.
CONTENT_GENERATION_ENABLED=false
CONTENT_GENERATION_MODEL="claude-sonnet-4-6"
CONTENT_GENERATION_EFFORT_SOCIAL=medium
CONTENT_GENERATION_EFFORT_LONGFORM=high
CONTENT_GENERATION_TIMEOUT_MS=60000
# Retained generic long-form timeout (no active platform uses it after podcast was retired).
CONTENT_GENERATION_PODCAST_TIMEOUT_MS=180000
CONTENT_GENERATION_CONCURRENCY=3
# Phase 11D.2 — newsletter output ceiling (was a hardcoded 4000; raised so complete
# Hebrew newsletters no longer truncate → retry → mock-fallback). Ceiling, not target.
CONTENT_NEWSLETTER_MAX_TOKENS=8000

# ── Research Synthesis (Phase 10A) ────────────────────────────
# Real cross-source synthesis for Research Context. MUST default false — when off,
# the research step uses the permanent v1 mock (wrapped as a v2 stub).
RESEARCH_SYNTHESIS_ENABLED=false
RESEARCH_SYNTHESIS_MODEL="claude-sonnet-4-6"
# Hebrew + many sources can exceed 120s; 240s avoids a degraded mock fallback.
RESEARCH_SYNTHESIS_TIMEOUT_MS=240000

# ── Pipeline integrity (Phase 10D.0) ──────────────────────────
# QA strict mode. Default false (production: continue safely + surface degradation
# everywhere). Set true in validation/CI so a degraded research stage (mock-fallback)
# FAILS the run before content generation — a failed research phase can never
# masquerade as success.
PIPELINE_FAIL_ON_DEGRADED=false

# ── Scheduler (Phase 14C) ─────────────────────────────────────
# In-process scheduler that triggers automatic generation per a case's schedule.
# Default OFF. When on, it ticks every SCHEDULER_INTERVAL_MINUTES, finds cases whose
# scheduled slot is due (in SCHEDULER_TIMEZONE), and runs them via the server-side
# runner (triggeredBy='schedule'). Never backfills missed slots. Also reaps stuck
# runs (status='running' older than SCHEDULER_STUCK_RUN_MINUTES) on each tick.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15
# IANA timezone used to interpret each case's scheduleTime ("HH:MM").
SCHEDULER_TIMEZONE=Asia/Jerusalem
# A PipelineRun stuck in 'running' beyond this many minutes is marked failed by the
# stuck-run reaper (so the case is not permanently blocked). Keep safely above the
# longest run. Used by the reaper (Phase 14D) — see REAPER_* below.
SCHEDULER_STUCK_RUN_MINUTES=30

# ── Stuck-run reaper (Phase 14D) ──────────────────────────────
# Always-on safety net, INDEPENDENT of the scheduler: periodically marks PipelineRuns
# stuck in 'running' (older than SCHEDULER_STUCK_RUN_MINUTES) as failed, so a crash
# mid-run can't permanently block a case via the already_running guard. Runs even when
# SCHEDULER_ENABLED=false. Default ON; set REAPER_ENABLED=false to disable all reaping.
REAPER_ENABLED=true
REAPER_INTERVAL_MINUTES=10

# ── WhatsApp Cloud API (Phase 13A) ────────────────────────────
# Meta WhatsApp Cloud API webhook plumbing. MUST default false — when off, the
# webhook still verifies signatures and logs inbound messages (testable), but
# NEVER sends an outbound message. The GET verification handshake always works so
# the webhook can be registered with Meta before the feature is switched on.
WHATSAPP_ENABLED=false
# 13A echo helper. Echo may send ONLY when WHATSAPP_ENABLED=true AND this is true
# AND all credentials below are set AND the inbound signature verified.
WHATSAPP_ECHO_ENABLED=false
# GET handshake shared secret (hub.verify_token) chosen when registering the webhook.
WHATSAPP_VERIFY_TOKEN=""
# HMAC key for X-Hub-Signature-256 verification of inbound POSTs (Meta App Secret).
WHATSAPP_APP_SECRET=""
# Outbound send credentials.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
# Base URL for building deep links into the app (used by later phases; unused in 13A).
APP_BASE_URL="http://localhost:5173"
# Phase 13B — human-dialable business WhatsApp number shown on /verify-whatsapp so
# users know where to send their verification code. Distinct from PHONE_NUMBER_ID.
WHATSAPP_DISPLAY_NUMBER=""

# ── Telegram Bot API (additional ingestion channel) ───────────
# MUST default false. When off, the webhook still verifies the secret header and
# dedupes/parses updates (testable), but NEVER sends an outbound message.
TELEGRAM_ENABLED=false
# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=""
# Shared secret passed to setWebhook(secret_token=…); compared to the
# X-Telegram-Bot-Api-Secret-Token header on every inbound update (fail closed).
TELEGRAM_WEBHOOK_SECRET=""
# Bot API base (override only for a self-hosted/local Bot API server).
TELEGRAM_API_BASE="https://api.telegram.org"
# Bot @username (without @) — builds the t.me/<bot>?start=<token> linking deep link.
TELEGRAM_BOT_USERNAME=""
